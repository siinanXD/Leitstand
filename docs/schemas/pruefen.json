{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ergebnis der Rolle pruefen",
  "type": "object",
  "properties": {
    "rolle": { "type": "string", "enum": ["pruefen"] },
    "issue": { "type": "string", "pattern": "^SIN-[0-9]+$" },
    "zeitpunkt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "status": { "type": "string", "enum": ["fertig", "blockiert", "braucht_sinan"] },
    "zusammenfassung": { "type": "string", "minLength": 1 },
    "naechster_schritt": { "type": "string", "minLength": 1 },
    "kosten_eur": { "type": "number", "minimum": 0 },
    "quellen": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "ergebnis": { "type": "string", "enum": ["gruen", "rot"] },
    "pruefungen": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 }, "ok": { "type": "boolean" } },
        "required": ["name", "ok"],
        "additionalProperties": false
      }
    }
  },
  "required": ["rolle", "issue", "zeitpunkt", "status", "zusammenfassung", "naechster_schritt", "kosten_eur", "quellen", "ergebnis", "pruefungen"],
  "additionalProperties": false
}
