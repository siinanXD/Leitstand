{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ergebnis der Rolle bauen",
  "type": "object",
  "properties": {
    "rolle": { "type": "string", "enum": ["bauen"] },
    "issue": { "type": "string", "pattern": "^SIN-[0-9]+$" },
    "zeitpunkt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "status": { "type": "string", "enum": ["fertig", "blockiert", "braucht_sinan"] },
    "zusammenfassung": { "type": "string", "minLength": 1 },
    "naechster_schritt": { "type": "string", "minLength": 1 },
    "kosten_eur": { "type": "number", "minimum": 0 },
    "quellen": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "art": { "type": "string", "enum": ["code", "design", "content", "video"] },
    "pr": { "type": "string", "minLength": 1 },
    "geaendert": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "required": ["rolle", "issue", "zeitpunkt", "status", "zusammenfassung", "naechster_schritt", "kosten_eur", "quellen", "art", "pr", "geaendert"],
  "additionalProperties": false
}
