{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ergebnis der Rolle botadvisor (SIN-713)",
  "description": "Interview (`fragen`, höchstens 5) und Entwurf (`agent`) eines neuen Agenten. Ohne Antworten nur `fragen`, danach auch `agent`. `secrets` sind Namen aus Infisical, nie Werte.",
  "type": "object",
  "properties": {
    "rolle": { "type": "string", "enum": ["botadvisor"] },
    "issue": { "type": "string", "pattern": "^SIN-[0-9]+$" },
    "zeitpunkt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "status": { "type": "string", "enum": ["fertig", "blockiert", "braucht_sinan"] },
    "zusammenfassung": { "type": "string", "minLength": 1 },
    "naechster_schritt": { "type": "string", "minLength": 1 },
    "kosten_eur": { "type": "number", "minimum": 0 },
    "quellen": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "satz": { "type": "string", "minLength": 1 },
    "fragen": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "frage": { "type": "string", "minLength": 1 },
          "warum": { "type": "string", "minLength": 1 },
          "vorschlag": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "frage", "warum"],
        "additionalProperties": false
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+$" },
        "name": { "type": "string", "minLength": 1 },
        "aufgabe": { "type": "string", "minLength": 1 },
        "system_prompt": { "type": "string", "minLength": 1 },
        "werkzeuge": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "takt": { "type": "string", "enum": ["ereignis", "stuendlich", "taeglich", "woechentlich", "monatlich"] },
        "secrets": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } },
        "ausgabe_schema": { "type": "object" }
      },
      "required": ["id", "name", "aufgabe", "system_prompt", "werkzeuge", "takt", "secrets", "ausgabe_schema"],
      "additionalProperties": false
    }
  },
  "required": ["rolle", "issue", "zeitpunkt", "status", "zusammenfassung", "naechster_schritt", "kosten_eur", "quellen", "satz", "fragen"],
  "additionalProperties": false
}
