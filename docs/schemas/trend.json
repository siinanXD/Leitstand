{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ergebnis der Rolle trend (SIN-575)",
  "description": "Zahlen, Lizenz und URL jedes Funds stammen aus der Messung, die Bewertung (betrifft bis jetzt_grund) von Haiku. Nicht erlaubt (Lizenz nicht MIT/Apache, inaktiv, höchstens 500 Sterne): höchstens `beobachten`. `zuwachs` ist eine Zahl oder null, `jetzt_grund` sicherheit, kosten oder null.",
  "type": "object",
  "properties": {
    "rolle": { "type": "string", "enum": ["trend"] },
    "issue": { "type": "string", "pattern": "^SIN-[0-9]+$" },
    "zeitpunkt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "status": { "type": "string", "enum": ["fertig", "blockiert", "braucht_sinan"] },
    "zusammenfassung": { "type": "string", "minLength": 1 },
    "naechster_schritt": { "type": "string", "minLength": 1 },
    "kosten_eur": { "type": "number", "minimum": 0 },
    "quellen": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "funde": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "quelle": { "type": "string", "enum": ["github", "huggingface", "changelog"] },
          "was": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "lizenz": { "type": "string", "minLength": 1 },
          "sterne": { "type": "integer", "minimum": 0 },
          "zuwachs": {},
          "aktiv": { "type": "boolean" },
          "betrifft": { "type": "string", "enum": ["lernapp", "leitstand", "alle", "keins"] },
          "nutzen": { "type": "string", "minLength": 1 },
          "aufwand_tage": { "type": "number", "minimum": 0, "maximum": 365 },
          "risiko": { "type": "string", "enum": ["niedrig", "mittel", "hoch"] },
          "empfehlung": { "type": "string", "enum": ["jetzt", "version", "beobachten", "nein"] },
          "jetzt_grund": { "enum": ["sicherheit", "kosten", null] },
          "datum": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        },
        "required": ["id", "quelle", "was", "url", "lizenz", "sterne", "zuwachs", "aktiv", "betrifft", "nutzen", "aufwand_tage", "risiko", "empfehlung", "jetzt_grund", "datum"],
        "additionalProperties": false
      }
    }
  },
  "required": ["rolle", "issue", "zeitpunkt", "status", "zusammenfassung", "naechster_schritt", "kosten_eur", "quellen", "funde"],
  "additionalProperties": false
}
