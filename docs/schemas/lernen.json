{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wochenmessung der Selbstlern-Schleife (SIN-576)",
  "description": "docs/lernen/woche-<KW>.json. Werte sind gemessen oder null (nicht gemessen, zu wenig Daten), nie geschätzt. `vorschlag` (Objekt oder null) ist höchstens eine Regelzeile je Woche, `nachmessung` (Objekt oder null) das Urteil über den Vorschlag der Vorwoche.",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "enum": ["lernen/1"] },
    "kw": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "von": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "bis": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "erstellt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "produkte": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produkt": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "prs": { "type": "integer", "minimum": 0 },
          "werte": {
            "type": "object",
            "properties": {
              "merges_pro_tag": {},
              "reparatur_anteil": {},
              "loop_anteil": {},
              "freigaben": {},
              "leerlauf_stunden": {},
              "kosten_usd_je_pr": {},
              "richter_quote": {},
              "fertig_anteil": {}
            },
            "required": ["merges_pro_tag", "reparatur_anteil", "loop_anteil", "freigaben", "leerlauf_stunden", "kosten_usd_je_pr", "richter_quote", "fertig_anteil"],
            "additionalProperties": false
          }
        },
        "required": ["produkt", "repo", "prs", "werte"],
        "additionalProperties": false
      }
    },
    "vorschlag": {
      "properties": {
        "produkt": { "type": "string", "minLength": 1 },
        "wert": { "type": "string", "enum": ["merges_pro_tag", "reparatur_anteil", "loop_anteil", "richter_quote", "fertig_anteil"] },
        "vorher": { "type": "number" },
        "ziel": { "type": "number" },
        "datei": { "type": "string", "pattern": "^(docs/skills/[a-z0-9-]+/SKILL\\.md|AGENTS\\.md)$" },
        "zeile": { "type": "string", "pattern": "^- ." },
        "erwartet": { "type": "string", "minLength": 1 },
        "kosten_eur": { "type": "number", "minimum": 0 }
      },
      "required": ["produkt", "wert", "vorher", "ziel", "datei", "zeile", "erwartet", "kosten_eur"],
      "additionalProperties": false
    },
    "nachmessung": {
      "properties": {
        "kw_vorschlag": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
        "produkt": { "type": "string", "minLength": 1 },
        "wert": { "type": "string", "minLength": 1 },
        "vorher": { "type": "number" },
        "nachher": {},
        "ergebnis": { "type": "string", "enum": ["behalten", "verworfen", "offen"] }
      },
      "required": ["kw_vorschlag", "produkt", "wert", "vorher", "nachher", "ergebnis"],
      "additionalProperties": false
    }
  },
  "required": ["schema", "kw", "von", "bis", "erstellt", "produkte", "vorschlag", "nachmessung"],
  "additionalProperties": false
}
