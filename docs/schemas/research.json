{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ergebnis der Rolle research",
  "type": "object",
  "properties": {
    "rolle": { "type": "string", "enum": ["research"] },
    "issue": { "type": "string", "pattern": "^SIN-[0-9]+$" },
    "zeitpunkt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "status": { "type": "string", "enum": ["fertig", "blockiert", "braucht_sinan"] },
    "zusammenfassung": { "type": "string", "minLength": 1 },
    "naechster_schritt": { "type": "string", "minLength": 1 },
    "kosten_eur": { "type": "number", "minimum": 0 },
    "quellen": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "treffer": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quelle": { "type": "string", "enum": ["github", "huggingface", "web", "context7"] },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "lizenz": { "type": "string", "minLength": 1 },
          "sterne": { "type": "integer", "minimum": 0 },
          "datum": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        },
        "required": ["quelle", "name", "url", "lizenz", "sterne", "datum"],
        "additionalProperties": false
      }
    },
    "empfehlung": { "type": "string", "enum": ["bauen", "anpassen", "nicht bauen"] }
  },
  "required": ["rolle", "issue", "zeitpunkt", "status", "zusammenfassung", "naechster_schritt", "kosten_eur", "quellen", "treffer", "empfehlung"],
  "additionalProperties": false
}
