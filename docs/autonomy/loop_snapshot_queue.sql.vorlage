-- SIN-572: Schlange des Leitstands als Zusammenfassung in loop_snapshot. Nicht unter supabase/migrations/, bis Sinan es freigibt.
-- Nach "Freigeben" als supabase/migrations/leitstand/<Zeitstempel>_loop_snapshot_queue.sql in einen eigenen PR verschieben.
-- Form: {"todo": 0, "startable": 0, "in_progress": 0}
alter table public.loop_snapshot add column if not exists queue jsonb;
