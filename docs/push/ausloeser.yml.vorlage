# Vorlage für .github/workflows/push-ausloeser.yml (SIN-426).
# Der Worker darf .github/workflows/ nicht ändern: Sinan legt die Datei an.
#
# Stündlich laufen. Die Uhrzeit in Europe/Berlin prüft der Code (src/lib/push/ausloeser.ts),
# deshalb gibt es nur einen Cron-Eintrag und keine Umstellung bei Sommer- und Winterzeit.
# Der Lauf entscheidet selbst, ob er sendet (Alarm, Braucht dich, Ruhezeit, Auswertung um 20:00).
name: push-ausloeser

on:
  schedule:
    - cron: "7 * * * *"
  workflow_dispatch:

concurrency:
  group: push-ausloeser
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  ausloeser:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      # Folgeschritt: scripts/push/ausloeser.ts liest die Quellen (loop_events, Linear, GitHub),
      # ruft plane() auf, sendet mit sendeAnAlle() und speichert plan.neu als gesendet.
      - run: npx tsx scripts/push/ausloeser.ts
        env:
          NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
          VAPID_PUBLIC_KEY: ${{ secrets.VAPID_PUBLIC_KEY }}
          VAPID_PRIVATE_KEY: ${{ secrets.VAPID_PRIVATE_KEY }}
          VAPID_SUBJECT: ${{ secrets.VAPID_SUBJECT }}
