# SIN-554: nach .github/workflows/markt.yml kopieren (der Worker darf .github/workflows/ nicht ändern). Sinan entscheidet.
# Am 1. des Monats: Claude prüft die Konkurrenz mit WebSearch/WebFetch, das Skript prüft das Ergebnis, schreibt docs/markt/<JJJJ-MM>.md
# und legt höchstens 3 Linear-Ideen an. Die Datei geht als PR auf main (Auto-Merge, weil nur docs/ betroffen ist).
# Bewusst keine Schreibrechte außer docs/markt/ und Linear-Ideen im Backlog.
name: markt
on:
  schedule:
    - cron: "23 5 1 * *"
  workflow_dispatch:
    inputs:
      dry_run:
        description: "Nur ins Log schreiben (keine Datei, keine Issues)"
        type: boolean
        default: true
permissions:
  contents: write
  pull-requests: write
jobs:
  markt:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      GH_TOKEN: ${{ secrets.AGENT_WORKFLOW_TOKEN }}
      MARKT_LINEAR_PROJEKT: Lern-App # Name des Linear-Projekts; Konkurrenzliste steht in docs/PRODUCT.md der Lern-App
    steps:
      - uses: actions/checkout@v6
        with:
          token: ${{ secrets.AGENT_WORKFLOW_TOKEN }}
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - name: Konkurrenz prüfen
        uses: anthropics/claude-code-action@v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          github_token: ${{ secrets.AGENT_WORKFLOW_TOKEN }}
          prompt: |
            Lies docs/skills/markt/SKILL.md und führe sie aus. Die Konkurrenzliste holst du mit
            `gh api repos/siinanXD/Content-Agent-Lernapp/contents/docs/PRODUCT.md --jq .content | base64 -d`.
            Schreibe markt-ergebnis.json im Repo-Wurzelverzeichnis. Sonst nichts ändern.
          claude_args: |
            --model claude-sonnet-5-5
            --max-turns 40
            --allowedTools "WebSearch,WebFetch,Write,Bash(gh api:*)"
      - run: npx tsx scripts/markt/markt.ts
        env:
          LINEAR_API_KEY: ${{ secrets.LINEAR_API_KEY }}
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
          DRY_RUN: ${{ inputs.dry_run && '1' || '' }}
      - name: PR mit docs/markt öffnen
        if: ${{ !inputs.dry_run }}
        run: |
          monat=$(date -u +%Y-%m)
          branch="markt/$monat"
          git config user.name "claude[bot]"
          git config user.email "claude[bot]@users.noreply.github.com"
          git checkout -b "$branch"
          git add "docs/markt/$monat.md"
          git commit -m "docs(markt): Konkurrenz $monat (SIN-554)" -m "Part of SIN-554"
          git push origin "$branch"
          gh pr create --head "$branch" --base main --title "docs(markt): Konkurrenz $monat (SIN-554)" --body "Monatlicher Markt-Bericht des Markt-Agenten. Part of SIN-554."
