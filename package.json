{
  "name": "leitstand",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43124",
    "build": "next build",
    "start": "next start --port 43124",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:fast": "node scripts/check-fast.mjs",
    "test": "node --import tsx --test $(find src -name \"*.test.ts\")",
    "test:a11y": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.15 autorun",
    "stand": "tsx scripts/stand/pruefen.ts",
    "knip": "knip --no-exit-code",
    "hausmeister": "tsx scripts/hausmeister/hausmeister.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@xyflow/react": "^12.12.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "knip": "^6.41.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
