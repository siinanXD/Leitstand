# Nur Namen, nie Werte. Echte Werte kommen aus Infisical (Pfad /leitstand) per GitHub-Sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig (Vercel): Freigabe im Leitstand, Eintrag in loop_events, GitHub-Zugriff auf Lern-App und Leitstand (Pull Requests: lesen, schreiben).
SUPABASE_SERVICE_ROLE_KEY=
LEITSTAND_GITHUB_TOKEN=
# Push-Mitteilungen (SIN-425), nur serverseitig (Vercel). VAPID_SUBJECT: mailto:… oder https://…
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Stand-Agent (SIN-508), nur im Workflow stand.yml. Nicht erreichbare Quellen erscheinen im Bericht als „fehlt“.
# Kosten (SIN-527), nur serverseitig (Vercel). Fehlen sie, steht die Quelle als „nicht verfügbar“. KOSTEN_USD_EUR: Kurs für Langfuse (USD → EUR).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
KOSTEN_USD_EUR=
KOSTEN_BUDGET_EUR=
# Wochendeckel in Euro (SIN-555), Standard 60.
KOSTEN_WOCHE_EUR=
# Gedächtnis-Agent (SIN-541), nur im Workflow gedaechtnis.yml: GH_TOKEN (AGENT_WORKFLOW_TOKEN), SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY. GEDAECHTNIS_AUSGABE: Ordner für den Trockenlauf.
GEDAECHTNIS_AUSGABE=
# Trend-Radar 2 (SIN-575), nur im Workflow trend.yml: LINEAR_API_KEY, ANTHROPIC_API_KEY, VORARBEITER_PREIS_*, KOSTEN_USD_EUR, SUPABASE_*. TREND_LINEAR_PROJEKT: Linear-Projekt der Issues (Standard Leitstand).
TREND_LINEAR_PROJEKT=
# Werkzeug-Prüfung (SIN-544), nur im Workflow werkzeuge.yml. Fehlt ein Key, steht das Tool auf der Werkzeuge-Seite rot.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
POSTMAN_API_KEY=
HF_TOKEN=
LINEAR_API_KEY=
FIGMA_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Vorarbeiter Spur C (SIN-553), nur im Workflow vorarbeiter.yml. Preise in USD je Million Token laut Anthropic-Preisliste.
VORARBEITER_PREIS_EIN_USD=
VORARBEITER_PREIS_AUS_USD=
# Abnahme-Proben (SIN-626), nur im Workflow abnahme.yml: Adresse der Leitstand-App für /api/health (Secret oder Repo-Variable).
LEITSTAND_URL=
